APP_NAME=WA Connect
APP_ENV=production
APP_DEBUG=false
API_PREFIX=/api/v1

# Public HTTPS URL of this WA Connect instance.
PUBLIC_BASE_URL=https://waconnect.example.com
CORS_ORIGINS=https://waconnect.example.com

# Local media remains inside this container path. The host path is controlled
# separately by MEDIA_LOCAL_HOST_PATH below.
INBOUND_MEDIA_DIR=/app/storage/inbound-media
MEDIA_LOCAL_HOST_PATH=./storage/inbound-media
MEDIA_SETTINGS_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Production listener exposed by docker-compose.prod.yml.
WA_CONNECT_PORT=8080
UVICORN_WORKERS=2

# MariaDB. Use URL-safe characters in MARIADB_PASSWORD because it is also used
# inside DATABASE_URL below. Long random hexadecimal values work well.
MARIADB_DATABASE=wa_connect
MARIADB_USER=wa_connect
MARIADB_PASSWORD=replace-with-a-long-random-password
MARIADB_ROOT_PASSWORD=replace-with-another-long-random-password
DATABASE_URL=mysql+pymysql://wa_connect:replace-with-a-long-random-password@db:3306/wa_connect

REDIS_URL=redis://redis:6379/0

META_GRAPH_API_VERSION=v23.0
META_VERIFY_TOKEN=replace-with-a-long-random-token
META_APP_SECRET=
META_ACCESS_TOKEN=

AUTH_COOKIE_NAME=wa_connect_session
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=true

# Used only to create the first administrator when the database is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=Administrator
