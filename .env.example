APP_NAME=WA Connect
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1

DATABASE_URL=mysql+pymysql://wa_connect:wa_connect@db:3306/wa_connect
REDIS_URL=redis://redis:6379/0

META_GRAPH_API_VERSION=v23.0
META_VERIFY_TOKEN=change-me
META_APP_SECRET=
META_ACCESS_TOKEN=

AUTH_COOKIE_NAME=wa_connect_session
AUTH_SESSION_DAYS=7
AUTH_COOKIE_SECURE=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-startup
BOOTSTRAP_ADMIN_NAME=Administrator

CORS_ORIGINS=https://waconnect.route2marketsolutions.com,http://localhost:5173
